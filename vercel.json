{
  "cleanUrls": true,
  "functions": {
    "api/ask.js": {
      "maxDuration": 120
    },
    "api/tts.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/judy",
      "destination": "/index.html?u=judy"
    }
  ]
}